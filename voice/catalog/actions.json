      "params": {},
      "risk": "low",
      "binding": "App.handleNavigate('home')",
      "binding_status": "existing"
    },
    {
      "id": "navigate_library",
      "category": "navigation",
      "description": "Open the Library, the list of explanations the learner has read or listened to before.",
      "screens": [
