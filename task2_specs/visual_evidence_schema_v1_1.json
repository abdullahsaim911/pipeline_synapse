{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synapse Single-Frame Visual Evidence v1.1",
  "description": "Canonical evidence record assembled by backend from one Qwen3 frame observation and existing metadata; not a model response contract and not final narration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_status",
    "evidence_status",
    "category_ids",
    "regions",
    "relations",
    "uncertainties",
    "structural_description",
    "validation_diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "frame_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "evidence_status": {
      "enum": [
        "supported",
        "partially_supported",
        "ambiguous_or_conflicting",
        "unavailable_or_unreadable"
      ]
    },
    "category_ids": {
      "$ref": "#/$defs/categories"
    },
    "raw_category_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "global_layout": {
      "type": [
        "string",
        "null"
      ]
    },
    "reading_order": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "description": "Backend-owned source paths/frame time, provider and extraction metadata. No invented model confidence."
    },
    "extraction_status": {
      "enum": [
        "complete",
        "partial",
        "failed",
        "not_attempted"
      ]
    },
    "structural_description": {
      "$ref": "#/$defs/structural_description"
    },
    "category_details": {
      "$ref": "#/$defs/category_details"
    },
    "exact_content": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exact_content"
      }
    },
    "validation_diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "legacy_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "description": "Original snapshot preserved unchanged; no inferred structure inserted."
    }
  },
  "$defs": {
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CT-01",
          "CT-02",
          "CT-03",
          "CT-04",
          "CT-05",
          "CT-06",
          "CT-07",
          "CT-08",
          "CT-09",
          "CT-10",
          "CT-11",
          "CT-12"
        ]
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "evidence_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "exact_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "type": [
            "string",
            "null"
          ]
        },
        "bbox_normalized": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "minItems": 4,
              "maxItems": 4,
              "items": false
            }
          ]
        },
        "evidence_status": {
          "enum": [
            "supported",
            "partially_supported",
            "ambiguous_or_conflicting",
            "unavailable_or_unreadable"
          ]
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category_ids",
        "elements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category_ids": {
          "$ref": "#/$defs/categories"
        },
        "position": {
          "type": [
            "string",
            "null"
          ]
        },
        "bbox_normalized": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "minItems": 4,
              "maxItems": 4,
              "items": false
            }
          ]
        },
        "reading_order_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "attributes": {
          "type": "object"
        },
        "evidence_status": {
          "enum": [
            "supported",
            "partially_supported",
            "ambiguous_or_conflicting",
            "unavailable_or_unreadable"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "target_id",
        "relation",
        "evidence_status"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "directed": {
          "type": "boolean"
        },
        "cross_category": {
          "type": "boolean"
        },
        "evidence_status": {
          "enum": [
            "supported",
            "partially_supported",
            "ambiguous_or_conflicting",
            "unavailable_or_unreadable"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "target_id",
        "reason"
      ],
      "properties": {
        "target_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "impact": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "structural_description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview",
        "orientation",
        "component_ids",
        "relation_ids",
        "reading_order",
        "uncertainties"
      ],
      "properties": {
        "overview": {
          "type": [
            "string",
            "null"
          ]
        },
        "orientation": {
          "type": [
            "string",
            "null"
          ]
        },
        "component_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "relation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "reading_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "hierarchy_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topology_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "category_details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chart": {
          "type": "object",
          "description": "Category-specific evidence. Only observed properties; no inferred mandatory facts.",
          "additionalProperties": true
        },
        "mathematics": {
          "type": "object",
          "description": "Category-specific evidence. Only observed properties; no inferred mandatory facts.",
          "additionalProperties": true
        },
        "scientific_structure": {
          "type": "object",
          "description": "Category-specific evidence. Only observed properties; no inferred mandatory facts.",
          "additionalProperties": true
        },
        "flow_network": {
          "type": "object",
          "description": "Category-specific evidence. Only observed properties; no inferred mandatory facts.",
          "additionalProperties": true
        },
        "table": {
          "type": "object",
          "description": "Category-specific evidence. Only observed properties; no inferred mandatory facts.",
          "additionalProperties": true
        },
        "structured_text": {
          "type": "object",
          "description": "Category-specific evidence. Only observed properties; no inferred mandatory facts.",
          "additionalProperties": true
        },
        "geometry": {
          "type": "object",
          "description": "Category-specific evidence. Only observed properties; no inferred mandatory facts.",
          "additionalProperties": true
        },
        "programming": {
          "type": "object",
          "description": "Category-specific evidence. Only observed properties; no inferred mandatory facts.",
          "additionalProperties": true
        },
        "interface": {
          "type": "object",
          "description": "Category-specific evidence. Only observed properties; no inferred mandatory facts.",
          "additionalProperties": true
        },
        "map": {
          "type": "object",
          "description": "Category-specific evidence. Only observed properties; no inferred mandatory facts.",
          "additionalProperties": true
        },
        "observational_image": {
          "type": "object",
          "description": "Category-specific evidence. Only observed properties; no inferred mandatory facts.",
          "additionalProperties": true
        },
        "physical_scene": {
          "type": "object",
          "description": "Category-specific evidence. Only observed properties; no inferred mandatory facts.",
          "additionalProperties": true
        }
      }
    },
    "exact_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "status"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "partially_supported",
            "ambiguous_or_conflicting",
            "unavailable_or_unreadable"
          ]
        },
        "notation": {
          "enum": [
            "plain",
            "math",
            "code",
            "chemical",
            "other"
          ]
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$comment": "Application validators must enforce bbox ordering, unique IDs, referential integrity, relation IDs, reading-order IDs, extraction-status consistency. JSON Schema alone cannot check cross-record references or visual truth."
}
