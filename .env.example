# -----------------------------------------------------------------------------
# Core API and persistence
# -----------------------------------------------------------------------------
# SQLite default (resolved relative to the repository root by api/database.py).
# Never put production credentials in this example file.
DATABASE_URL=sqlite:///./synapse.db
SYNAPSE_ENV=development
SYNAPSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROCESSING_JOIN_TIMEOUT_SECONDS=14400
PROCESSING_SHUTDOWN_GRACE_SECONDS=5
PREPARATION_SHUTDOWN_GRACE_SECONDS=5
SYNAPSE_MODAL_WARMUP_SHUTDOWN_SECONDS=1

# Human-readable, single-line console logs are the default. Use `json` for
# stable machine-readable events with full diagnostic tracebacks.
SYNAPSE_LOG_FORMAT=shell
SYNAPSE_LOG_LEVEL=INFO

# Optional interaction detection. Set to 0 to disable; enabled when unset.
SYNAPSE_INTERACTIONS=1

# Optional explicit FFmpeg executable. When unset, Synapse checks its bundled
# module path, system PATH, then the imageio-ffmpeg dependency.
# SYNAPSE_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# -----------------------------------------------------------------------------
# Qwen3-VL visual extraction
# -----------------------------------------------------------------------------
# Supported values: modal (default) or local. The current maintained pipeline
# expects the Modal URL and bearer key when modal is selected.
SYNAPSE_VLM_PROVIDER=modal
# SYNAPSE_MODAL_URL=https://your-workspace--synapse-modal.modal.run
# SYNAPSE_MODAL_API_KEY=replace-with-a-secret-from-your-local-env
SYNAPSE_MODAL_TIMEOUT_SECONDS=120
SYNAPSE_MODAL_MAX_RETRIES=3
# Wake the scale-to-zero Modal container during backend startup and wait until
# vLLM has loaded the model. The health probe performs no text generation.
SYNAPSE_MODAL_WARMUP_ON_STARTUP=true
SYNAPSE_MODAL_WARMUP_TIMEOUT_SECONDS=600
SYNAPSE_VLM_STRUCTURED_MAX_TOKENS=2048
SYNAPSE_MODAL_MAX_TOKENS=2048
SYNAPSE_QWEN_PROCESSOR_LOCAL_FILES_ONLY=1
SYNAPSE_VLM_REQUIRE_EXACT_CONTEXT_BUDGET=1

# Modal deployment only (not required by the local API client):
# HF_TOKEN=replace-with-a-hugging-face-token-if-the-model-requires-one

# Task 5 explanation synthesis currently uses local Ollama at
# http://localhost:11434 with model "mistral". Those values are code-level
# configuration, not environment variables. Ollama must be installed locally.
# Optional explicit executable path. When unset, Synapse checks PATH and then
# Ollama's standard per-user Windows installation directories.
# SYNAPSE_OLLAMA_PATH=C:\Users\your-name\AppData\Local\Programs\Ollama\ollama.exe
# Mistral defaults to CPU inference with a 2048-token context. These optional
# overrides are sent as Ollama's num_gpu and num_ctx generation options.
# SYNAPSE_OLLAMA_NUM_GPU=0
# SYNAPSE_OLLAMA_NUM_CTX=2048
# TTS uses Edge TTS first and SpeechT5 as the existing fallback; it has no
# environment-variable configuration. Network/model availability still applies.

# -----------------------------------------------------------------------------
# Ask and quiz text generation (Gemini)
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
# GEMINI_API_KEY=replace-with-a-secret-from-your-local-env
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
QUIZ_ENABLED=true

# Ask prompt/retrieval limits. Advanced hybrid and faithfulness paths are off
# unless explicitly enabled because they may require locally cached models.
ASK_MAX_PROMPT_TOKENS=4000
ASK_FULL_TRANSCRIPT_MAX_TOKENS=2000
ASK_CHARS_PER_TOKEN=3.5
# ASK_MAX_EVIDENCE_CHARS=12000
ASK_ASR_SANITIZE=0
# ASK_ASR_TERMS_FILE=path/to/extra_terms.txt
ASK_HYBRID_RETRIEVAL=0
# ASK_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ASK_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ASK_RRF_K=60
ASK_HYBRID_CANDIDATES=12
ASK_RERANK_TOP_K=4
ASK_MODELS_ALLOW_DOWNLOAD=0
ASK_FAITHFULNESS_MODE=off
ASK_FAITHFULNESS_METHOD=lexical
ASK_FAITHFULNESS_THRESHOLD=0.6
# ASK_NLI_MODEL=cross-encoder/nli-deberta-v3-small

# -----------------------------------------------------------------------------
# Optional YouTube search
# -----------------------------------------------------------------------------
# Search is unavailable without this server-side YouTube Data API v3 key; video
# processing by an already-known YouTube URL does not require it.
# YOUTUBE_API_KEY=replace-with-a-youtube-data-api-key

# PostgreSQL example for a future deployment:
# DATABASE_URL=postgresql+psycopg://synapse:change-me@localhost:5432/synapse

# Modal readiness. The backend starts immediately; warming happens in the
# background and is checked again before each extraction. A warm-up request
# starts a scaled-to-zero GPU container (billed) but runs no inference.
# SYNAPSE_MODAL_WARMUP_ON_STARTUP=1
# SYNAPSE_MODAL_WARMUP_TIMEOUT_SECONDS=600
# SYNAPSE_MODAL_WARMUP_ATTEMPT_SECONDS=60

# How long Mistral stays loaded after a request. Defaults to 5m with the remote
# VLM and 0 (release VRAM immediately) with a local VLM.
# SYNAPSE_OLLAMA_KEEP_ALIVE=5m
